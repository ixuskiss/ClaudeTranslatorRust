// Ctrl+Ctrl explanation window (v5 §4.6, palette §4.1).
import { ScrollView } from "std-widgets.slint";

export struct ExplainLine {
    tag: string,
    text: string,
}

export struct ExplainCard {
    original: string,
    translations: [ExplainLine],
}

export struct SheetCell {
    present: bool,
    original: string,
    lines: [ExplainLine],
}

export struct SheetRow {
    header: string,
    cells: [SheetCell],
}

// Invisible strip along an edge or corner that starts a native resize in `dir`.
component Edge inherits TouchArea {
    in property <string> dir;
    callback resize(string);
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.resize(root.dir);
        }
    }
}

export component ExplainWin inherits Window {
    in property <string> status;
    in property <[ExplainCard]> cards;
    in property <bool> has-table;
    in property <string> table-caption;
    in property <[string]> col-headers;
    in property <[SheetRow]> table-rows;
    // Table geometry: 220 px is the minimum (and initial-size) column width, 28 px the
    // minimum row height. Columns stretch to share the visible width and follow resizes;
    // below the minimum the table scrolls horizontally.
    out property <length> table-width: 40px + root.col-headers.length * 220px;
    property <length> col-width: root.col-headers.length == 0 ? 220px
        : max(220px, (tv.visible-width - 40px) / root.col-headers.length);
    property <length> laid-width: 40px + root.col-headers.length * root.col-width;
    out property <length> content-width: root.has-table ? root.table-width : column.preferred-width;
    out property <length> content-height: root.has-table ? tcol.preferred-height : column.preferred-height;
    callback close-requested();
    callback drag-requested();
    callback resize-requested(string);

    title: "ClaudeTranslator - Explanation";
    no-frame: true;
    background: transparent;
    min-width: 480px;
    min-height: 240px;
    preferred-width: 480px;
    preferred-height: 240px;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        Rectangle {
            background: #FBEEEC;
            border-radius: 14px;

            // Left-press anywhere outside the content drags the window.
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.drag-requested();
                    }
                }
            }

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 6px;

                HorizontalLayout {
                    Text {
                        text: "ClaudeTranslator";
                        font-weight: 700;
                        color: #8A8A8A;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        Text {
                            text: "✕";
                            color: #8A8A8A;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.close-requested();
                            }
                        }
                    }
                }

                if root.status != "": Text {
                    text: root.status;
                    color: #2B2B2B;
                    wrap: word-wrap;
                }

                tv := ScrollView {
                    visible: root.has-table;
                    max-height: root.has-table ? 100000px : 0px;
                    vertical-stretch: 1;
                    content-width: root.laid-width;
                    content-height: tcol.preferred-height;
                    tcol := VerticalLayout {
                        width: root.laid-width;
                        alignment: start;
                        if root.table-caption != "": Text {
                            text: root.table-caption;
                            font-weight: 700;
                            color: #8A8A8A;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            height: 24px;
                            Rectangle {
                                width: 40px;
                                background: #F1E4E1;
                            }

                            for h in root.col-headers: Rectangle {
                                width: root.col-width;
                                background: #F1E4E1;
                                Text {
                                    text: h;
                                    font-weight: 700;
                                    color: #8A8A8A;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        for row in root.table-rows: HorizontalLayout {
                            min-height: 28px;
                            Rectangle {
                                width: 40px;
                                background: #F1E4E1;
                                Text {
                                    text: row.header;
                                    color: #8A8A8A;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            for cell in row.cells: Rectangle {
                                width: root.col-width;
                                background: #FFFFFF;
                                border-width: 1px;
                                border-color: #E6D5D1;
                                VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 2px;
                                    alignment: start;
                                    if cell.present: TextInput {
                                        text: cell.original;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-weight: 700;
                                        color: #2B2B2B;
                                    }

                                    for line in cell.lines: VerticalLayout {
                                        if line.tag != "": Text {
                                            text: line.tag;
                                            font-size: 10px;
                                            color: #8A8A8A;
                                        }
                                        TextInput {
                                            text: line.text;
                                            read-only: true;
                                            single-line: false;
                                            wrap: word-wrap;
                                            font-weight: 700;
                                            color: #2563EB;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                sv := ScrollView {
                    visible: !root.has-table;
                    max-height: root.has-table ? 0px : 100000px;
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: column.preferred-height;
                    column := VerticalLayout {
                        width: sv.visible-width;
                        spacing: 10px;
                        alignment: start;
                        for card in root.cards: Rectangle {
                            background: #FFFFFF;
                            border-radius: 10px;
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 4px;
                                TextInput {
                                    text: card.original;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    font-weight: 700;
                                    color: #2B2B2B;
                                }

                                for line in card.translations: VerticalLayout {
                                    if line.tag != "": Text {
                                        text: line.tag;
                                        font-size: 10px;
                                        color: #8A8A8A;
                                    }
                                    TextInput {
                                        text: line.text;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-weight: 700;
                                        color: #2563EB;
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    text: "닫기 Esc";
                    color: #8A8A8A;
                    horizontal-alignment: right;
                }
            }
        }

        // 6 px resize zones; corners last so they win over the edges.
        Edge {
            x: 0;
            y: 6px;
            width: 6px;
            height: root.height - 12px;
            mouse-cursor: ew-resize;
            dir: "w";
            resize(d) => { root.resize-requested(d); }
        }

        Edge {
            x: root.width - 6px;
            y: 6px;
            width: 6px;
            height: root.height - 12px;
            mouse-cursor: ew-resize;
            dir: "e";
            resize(d) => { root.resize-requested(d); }
        }

        Edge {
            x: 6px;
            y: 0;
            width: root.width - 12px;
            height: 6px;
            mouse-cursor: ns-resize;
            dir: "n";
            resize(d) => { root.resize-requested(d); }
        }

        Edge {
            x: 6px;
            y: root.height - 6px;
            width: root.width - 12px;
            height: 6px;
            mouse-cursor: ns-resize;
            dir: "s";
            resize(d) => { root.resize-requested(d); }
        }

        Edge {
            x: 0;
            y: 0;
            width: 6px;
            height: 6px;
            mouse-cursor: nwse-resize;
            dir: "nw";
            resize(d) => { root.resize-requested(d); }
        }

        Edge {
            x: root.width - 6px;
            y: root.height - 6px;
            width: 6px;
            height: 6px;
            mouse-cursor: nwse-resize;
            dir: "se";
            resize(d) => { root.resize-requested(d); }
        }

        Edge {
            x: root.width - 6px;
            y: 0;
            width: 6px;
            height: 6px;
            mouse-cursor: nesw-resize;
            dir: "ne";
            resize(d) => { root.resize-requested(d); }
        }

        Edge {
            x: 0;
            y: root.height - 6px;
            width: 6px;
            height: 6px;
            mouse-cursor: nesw-resize;
            dir: "sw";
            resize(d) => { root.resize-requested(d); }
        }
    }
}
